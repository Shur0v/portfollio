[Unit]
Description=Shurov portfolio (isolated Next.js service)
After=network.target

[Service]
Type=simple
User=shurov-portfolio
Group=shurov-portfolio
WorkingDirectory=/srv/shurov-portfolio/current
Environment=NODE_ENV=production
EnvironmentFile=/srv/shurov-portfolio/shared/production.env
ExecStart=/opt/shurov-portfolio/node/bin/node /srv/shurov-portfolio/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3047
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/shurov-portfolio/shared/storage /srv/shurov-portfolio/current/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
